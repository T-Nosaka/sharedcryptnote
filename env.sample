# NextAuth.js のセッションを暗号化するための秘密鍵です。任意の文字列で構いません。
NEXTAUTH_SECRET=abcde

# Google Cloud Platform で取得した Client ID
GOOGLE_CLIENT_ID=hogehoge.apps.googleusercontent.com

# Google Cloud Platform で取得した Client Secret
GOOGLE_CLIENT_SECRET=GOCSPX-hogehogehoge_hogehoge

# Callback URL (http://localhost:3000/api/auth/callback/google)
NEXTAUTH_URL=https://hogehoge.com.internal

# Allow users
# ALLOWUSERS=/git-repos/allowusers.json

